Trebol [
    title: "The designer's machines: the structure, the properties and the code of the machines a file makes"
]

; Run by app.trb (do), so it shares the app's words: d, text, edit, code-view. The header's Edit switch
; shows either the screens of a file or its machines; both write the same text, through the same Undo.
; What is chosen is kept by place, [k id what]: the k-th machine of the file, and the id of one of its
; nodes (what = 'machine or 'state) or of one of its ways (what = 'way).

editing: "Screens"      ; or "Machines": what the window edits
ms: []                  ; the machines of the design, read again with it
picked: none            ; [k id what], or none
keep-mprops: false      ; a property being typed in: the panel stays, so the typing goes on

picked-machine: does [all [picked  pick ms picked/1]]
picked-node: does [all [m: picked-machine  picked/3 <> 'way  machine-node m picked/2]]
picked-way: does [all [m: picked-machine  picked/3 = 'way  pick m/ways picked/2]]

show-editing: function [what [string!]] [
    set 'editing what
    machines?: what = "Machines"
    add-button/hidden: structure/hidden: machines?
    machine-side/hidden: not machines?
    preview-pane/hidden: any [machines?  mode-f/value = "Code"]
    machine-pane/hidden: any [not machines?  mode-f/value = "Code"]
    unless machines? [stop-try none]
    redraw
]

; --- the structure -----------------------------------------------------------------------------

; the title at the top of the properties, its words on lines short enough for the panel, so it never scrolls
title-lines: function ["A title broken into lines of at most 26 characters, between words" t [string!]] [
    out: copy ""
    line: 0
    foreach w split t #" " [
        case [
            line = 0 []
            line + 1 + (length? w) > 26 [append out newline  line: 0]
            true [append out " "  line: line + 1]
        ]
        append out w
        line: line + length? w
    ]
    out
]

state-title: function [m [object!] n [object!]] [
    t: rejoin [n/kind " " n/name]
    if n/uses [append t rejoin [" uses " n/uses]]
    p: all [n/parent  machine-node m n/parent]
    if all [p  p/initial = n/name] [append t " (initial)"]
    t
]

way-title: function [m [object!] w [object!]] [
    to-names: collect [foreach [b k] w/targets [keep mold pick b k]]
    t: either w/kind = 'to [rejoin ["to " first to-names]] [rejoin [form any [w/kind "from"] " " form to-names]]
    l: way-label w
    if all [not empty? l  w/kind = 'to] [append t rejoin [" on " l]]
    if all [w/events  w/kind <> 'to] [append t rejoin [" on " form w/events]]
    t
]

node-tree: function [m [object!] k [integer!] id [integer!]] [
    n: machine-node m id
    node: make map! reduce [
        'id rejoin [either id = 1 ["m"] ["s"] k "." id]
        'name either id = 1 [rejoin [either m/name [rejoin [m/name ": "]] [""] m/kind]] [state-title m n]
    ]
    kids: collect [
        foreach c n/children [keep node-tree m k c]
        ; the ways out of a state hang from it; one that names no state here, from its level
        foreach w m/ways [
            src: way-source m w
            if any [src = id  all [none? src  w/level = id]] [
                keep make map! reduce ['id rejoin ["w" k "." w/id] 'name way-title m w]
            ]
        ]
    ]
    unless empty? kids [node/children: kids  node/expanded: true]
    node
]

tree-id: function [p [block!]] [rejoin [select [machine "m" state "s" way "w"] p/3 p/1 "." p/2]]

pick-machine: function ["Chooses what a row of the machines' structure is, or of the drawing" id [string!]] [
    unless p: canvas-place id [exit]
    set 'picked p
    machine-tree/selected: machine-node-of id machine-tree/data
    mark-machine
    draw-machine
    fill-mprops
]

redraw-machines: function [] [
    set 'ms either d [machines-of d] [copy []]
    prune-opened
    if all [picked  any [not pick ms picked/1  not either picked/3 = 'way [picked-way] [picked-node]]] [set 'picked none]
    k: 0
    machine-tree/data: collect [foreach m ms [k: k + 1  keep node-tree m k 1]]
    machine-tree/selected: all [picked  machine-node-of tree-id picked machine-tree/data]
    machine-none/hidden: not machine-tree/hidden: empty? ms
    show-machine-problems
    if editing = "Machines" [
        mark-machine
        draw-machine
        either keep-mprops [set 'keep-mprops false] [fill-mprops]
    ]
]

; what the engine says is wrong with each machine: the first mistake it finds, where it is written; or,
; when it is made, its warnings (a state no way leads to yet), each starting with warning:
machine-problems-of: function [] [
    collect [
        foreach m ms [
            named: either m/name [rejoin [m/name ": "]] [""]
            if all [m/kind <> 'fragment  late: late-use-problem d ms m] [
                keep make map! reduce ['at any [late/1 ""] 'message rejoin [named late/2]]
                continue
            ]
            e: either m/kind = 'fragment [fragment-problem m] [try [machine-engine/make-machine engine-block ms m]]
            if error? e [
                msg: e/message
                if find/match msg "machine: " [msg: skip msg 9]
                keep make map! reduce ['at any [e/at ""] 'message rejoin [named msg]]
            ]
            if object? e [
                foreach [p msg] e/warnings [
                    keep make map! reduce ['at any [loaded-at p ""] 'message rejoin ["warning: " named msg] 'warning true]
                ]
            ]
        ]
    ]
]

; "No problems", "2 problems", "1 problem, 1 warning", "No problems, 2 warnings"
problem-count-text: function [n [integer!] w [integer!]] [
    t: copy either n = 0 ["No problems"] [rejoin [n either n = 1 [" problem"] [" problems"]]]
    if w > 0 [append t rejoin [", " w either w = 1 [" warning"] [" warnings"]]]
    t
]

show-machine-problems: function [] [
    machine-problems/data: machine-problems-of
    machine-problems/hidden: empty? machine-problems/data
    if d [
        w: 0
        foreach p machine-problems/data [if select p 'warning [w: w + 1]]
        n: (length? problems/data) + (length? machine-problems/data) - w
        problem-count/text: problem-count-text n w
    ]
]

machine-node-of: function [id list [block!]] [
    foreach n list [
        if n/id = id [return n]
        if n/children [if found: machine-node-of id n/children [return found]]
    ]
    none
]

; --- the drawing ---------------------------------------------------------------------------------

graph-data: function ["What the drawing of the k-th machine is given: its nodes and ways, by the structure's ids" k [integer!]] [
    m: pick ms k
    places: machine-places text machine-key d m
    inner: copy []  inner-ways: copy []
    nodes: collect [
        foreach n m/nodes [
            p: all [n/parent  machine-node m n/parent]
            ; where it is drawn, from the box it is in, when the file says
            xy: none
            if n/id > 1 [
                path: machine-path m n/id
                foreach [s spot] places [if path = to block! s [xy: spot]]
            ]
            keep make map! reduce [
                'x either xy [xy/x] [none]
                'y either xy [xy/y] [none]
                'id rejoin [either n/id = 1 ["m"] ["s"] k "." n/id]
                'name form n/name
                'kind form n/kind
                'parent either p [rejoin [either p/id = 1 ["m"] ["s"] k "." p/id]] [none]
                'initial to logic! all [p  p/initial = n/name]
                'uses either n/uses [form n/uses] [none]
            ]
            ; opened, a state that uses a fragment shows it inside, to be seen there
            id: rejoin ["s" k "." n/id]
            if all [n/uses  find opened id  f: fragment-named ms n/uses] [
                more: fragment-inside id rejoin [k "." n/id] id f either m/name [reduce [m/name]] [copy []]
                append inner more/1
                append inner-ways more/2
            ]
        ]
    ]
    append nodes inner
    ways: collect [
        foreach w m/ways [
            if src: way-source m w [
                keep make map! reduce [
                    'id rejoin ["w" k "." w/id]
                    'from rejoin ["s" k "." src]
                    'to collect [foreach t way-targets m w [if t [keep rejoin ["s" k "." t]]]]
                    'label way-label w
                    'events either w/events [form w/events] [""]
                ]
            ]
        ]
    ]
    append ways inner-ways
    make map! reduce ['name either m/name [form m/name] [none] 'kind form m/kind 'nodes nodes 'ways ways]
]

; the chosen machine, or the first; none when the file makes none
draw-machine: function [] [
    if all [trying  text <> try-text] [stop-try "The code changed: try it again."]
    k: either picked [picked/1] [1]
    p: make machine-drawing/props [
        graph: either pick ms k [graph-data k] [none]
        selected: either picked [tree-id picked] [none]
        active: try-active
        editing: edit-next
        canUndo: can-undo? hist
        canRedo: can-redo? hist
    ]
    ; set by path: a trying: in the block would make the word local to this function
    p/trying: to logic! trying
    machine-drawing/props: p
    set 'edit-next none
]

; a drag in the drawing from one state onto another: a new way between them, chosen
machine-connect: function [ids [block!]] [
    a: split next first ids #"."
    b: split next second ids #"."
    k: to integer! a/1
    if k <> to integer! b/1 [exit]
    unless m: pick ms k [exit]
    from: to integer! a/2
    to-id: to integer! b/2
    unless t: add-way d m from to-id 'go [exit]
    edit t
    ; the way is the last one of its level that leaves from there to there
    foreach w select pick ms k 'ways [
        if all [from = way-source pick ms k w  find way-targets pick ms k w to-id] [set 'picked reduce [k w/id 'way]]
    ]
    redraw
]

; what is chosen, marked in the code
picked-span: function [] [
    unless m: picked-machine [return none]
    switch picked/3 [
        machine [block-span d m/block]
        state [n: picked-node  range-span d n/holder n/from n/to]
        way [w: picked-way  range-span d w/block w/from w/to]
    ]
]

mark-machine: function [] [
    s: picked-span
    code-view/props: make code-view/props [mark: either s [reduce [s/x s/y]] [none]]
]

; the cursor put in the code: the innermost state or way written around it
machine-caret: function [at [integer!]] [
    spots: copy []      ; [k id what span ...]: every machine, state and way, where it is written
    k: 0
    foreach m ms [
        k: k + 1
        append spots reduce [k 1 'machine block-span d m/block]
        foreach n next m/nodes [append spots reduce [k n/id 'state range-span d n/holder n/from n/to]]
        foreach w m/ways [append spots reduce [k w/id 'way range-span d w/block w/from w/to]]
    ]
    best: none
    foreach [k id what s] spots [
        if all [at >= s/x  at <= (s/x + s/y)  any [not best  s/y <= best/4/y]] [best: reduce [k id what s]]
    ]
    if all [best  any [not picked  (copy/part best 3) <> picked]] [
        set 'picked copy/part best 3
        machine-tree/selected: machine-node-of tree-id picked machine-tree/data
        mark-machine
        draw-machine
        fill-mprops
    ]
]

; --- adding --------------------------------------------------------------------------------------

new-machine-code: function [] [
    names: collect [foreach m ms [if m/name [keep m/name]]]
    name: 'machine-1
    k: 1
    while [find names name] [k: k + 1  name: to word! rejoin ["machine-" k]]
    rejoin [name ": machine [" newline "    initial start" newline "    state start []" newline "]" newline]
]

machine-add: function ["What the Add menu of the machines does" item [word!]] [
    if item = 'fragment [
        code: new-fragment-code ms
        edit fragment-before-machines d ms code
        k: 1
        foreach m ms [if m/name = to word! first split code #":" [break]  k: k + 1]
        set 'picked reduce [k 1 'machine]
        redraw
        exit
    ]
    if item = 'machine [
        t: copy text
        unless any [empty? t  newline = last t] [append t newline]
        unless empty? t [append t newline]
        edit append t new-machine-code
        set 'picked reduce [length? ms 1 'machine]
        redraw
        exit
    ]
    unless m: picked-machine [exit]
    ; inside the chosen state, or the level of the chosen way
    at: either w: picked-way [w/level] [picked/2]
    if 'final = select machine-node m at 'kind [at: select machine-node m at 'parent]
    base: select [state state final done parallel together] item
    name: fresh-state-name m base
    if t: add-state d m at name item [
        k: picked/1
        edit t
        foreach n select pick ms k 'nodes [if n/name = name [set 'picked reduce [k n/id 'state]]]
        redraw
    ]
]

; --- the properties ------------------------------------------------------------------------------

code-field: function [label [string!] help [string!] what value] [
    compose/deep [
        text (label)
        widget <trebol-code-small> [] with [value: (any [value ""])] on-change [machine-act (to lit-word! what) value]
        text small muted (help)
    ]
]

state-choices: function [m [object!]] [
    collect [foreach n next m/nodes [keep form to path! machine-path m n/id]]
]

machine-props-code: function [] [
    m: picked-machine
    switch picked/3 [
        machine [
            if m/kind = 'fragment [return fragment-props-code m]
            compose/deep [
                code (rejoin [either m/name [rejoin [m/name ": "]] [""] "machine"])
                text small muted "Drag states onto the drawing from its bar, and from the dots around a state to another to make a way."
                field "name" "the word it is set to" with [value: (either m/name [form m/name] [""])] on-change [machine-act 'machine-name value]
                (code-field "data" "its fields and their first values: parts: 0" 'data state-word-value d m 1 'data)
                button #trash "Delete" danger [machine-act 'delete-machine none]
            ]
        ]
        state [
            n: picked-node
            p: machine-node m n/parent
            out: compose/deep [
                code (title-lines state-title m n)
                text small muted (form to path! machine-path m n/id)
                field "name" "word" with [value: (form n/name)] on-change [machine-act 'name value]
            ]
            if p/kind <> 'parallel [
                append out compose/deep [
                    check "initial: its level starts here" with [value: (p/initial = n/name)] on-change [machine-act 'initial value]
                ]
            ]
            if n/kind = 'final [
                append out compose/deep [
                    field "outcome" "the word the machine ends with" with [value: (either n/outcome [form pick n/holder n/outcome] [""])]
                        on-change [machine-act 'outcome value]
                ]
            ]
            append out use-props-code m n
            append out code-field "on-enter" "runs when the machine comes into it" 'on-enter state-word-value d m n/id 'on-enter
            append out code-field "on-exit" "runs when the machine leaves it" 'on-exit state-word-value d m n/id 'on-exit
            if n/kind <> 'final [
                append out compose/deep [
                    field "timeout" "seconds, a time (0:15) or data/field" with [value: (any [state-word-value d m n/id 'timeout ""])]
                        on-change [machine-act 'timeout value]
                ]
                append out code-field "run" "work that takes a while: done or error when it ends" 'run state-word-value d m n/id 'run
                append out compose/deep [
                    field "defer" "events kept until a state takes them" with [value: (any [state-word-value d m n/id 'defer ""])]
                        on-change [machine-act 'defer value]
                ]
            ]
            unless empty? n/children [
                if n/kind = 'state [
                    append out compose/deep [
                        check "history: comes back to the state it left" with [value: (not select n/words 'no)] on-change [machine-act 'history value]
                    ]
                ]
            ]
            append out compose/deep [
                row [
                    button #arrow-right "Add a way" menu [(collect [foreach n next m/nodes [keep form to path! machine-path m n/id  keep to word! rejoin ["state-" n/id]]])]
                        on-menu [machine-act 'way-to event/picked]
                    button #trash "Delete" danger [machine-act 'delete none]
                ]
            ]
            out
        ]
        way [
            w: picked-way
            out: compose/deep [
                code (title-lines rejoin ["from " w/source " " way-title m w])
                field "on" "the events it is taken on: start, or [start go]" with [value: (either w/events [form w/events] [""])]
                    on-change [machine-act 'events value]
            ]
            if w/kind = 'to [
                append out compose/deep [
                    choice "to" [(state-choices m)] with [value: (form to path! machine-path m any [first way-targets m w 1])]
                        on-change [machine-act 'target value]
                ]
            ]
            if w/branches [
                append out compose/deep [
                    text small muted (rejoin [either w/kind = 'select ["select"] ["choose"] ": " (length? w/choices) / 3 " branches, in the code"])
                ]
            ]
            if w/events [append out code-field "where" "a condition: the way is taken only when it holds" 'where way-code d w 'where]
            append out code-field "set" "the data it changes when taken: parts: event/count" 'set way-code d w 'set
            append out [button #trash "Delete" danger [machine-act 'delete-way none]]
            out
        ]
    ]
]

fill-mprops: function [] [
    if any [editing <> "Machines"  not try-panel/hidden] [exit]
    machine-props/hidden: not picked
    nothing-chosen/hidden: to logic! picked
    props/hidden: true
    if picked [machine-props/pane: layout/only machine-props-code]
]

; what a control of the machine's properties did
machine-act: function [what [word!] value] [
    unless m: picked-machine [exit]
    n: picked-node
    w: picked-way
    id: picked/2
    if find [name machine-name data outcome on-enter on-exit timeout run defer events where set spec use-with] what [set 'keep-mprops true]
    t: switch what [
        name [all [string? value  v: attempt [load value]  word? v  rename-state d m id v]]
        initial [either value [set-initial d m id] [none]]
        outcome [
            v: all [string? value  attempt [load value]]
            s: all [n/outcome  span-of d n/holder n/outcome]
            case [
                all [s  any [none? v  v = []]] [splice d/text s/x - 1 s/y + 1 ""]
                not word? v [none]
                s [splice d/text s/x s/y form v]
                true [s: span-of d n/holder n/from + 1  splice d/text s/x + s/y 0 rejoin [" " v]]
            ]
        ]
        data on-enter on-exit run [set-state-word d m id what value]
        timeout defer [set-state-word d m id what value]
        history [set-state-word d m id 'no either value [none] ["history"]]
        way-to [add-way d m id to integer! skip form value 6 'go]
        delete [r: delete-state d m id  set 'picked none  r]
        machine-name [
            v: all [string? value  attempt [load value]]
            r: all [word? v  rename-machine d ms m v]
            if r [r: rename-machine-places r machine-key d m v]
            r
        ]
        delete-machine [
            r: delete-machine-text d m
            if r [r: rename-machine-places r machine-key d m none]
            set 'picked none
            r
        ]
        spec [all [string? value  set-fragment-spec d m value]]
        use [set-use d m id either value = "(none)" [none] [to word! value]]
        use-with [set-use-with d m id value]
        events [
            v: any [attempt [load/all any [value ""]] copy []]
            if all [block? v  1 = length? v  block? first v] [v: first v]
            either all [block? v  parse v [any word!]] [set-way-events d m w v] [none]
        ]
        target [set-way-target d m w find-machine-state m 1 load value]
        where set [set-way-code d m w what value]
        delete-way [r: delete-way d m w  set 'picked none  r]
    ]
    either t [edit t] [set 'keep-mprops false]
]

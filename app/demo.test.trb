Trebol [title: "The designer as a demo, on a page of trebol build" app: %app.trb]

; on the web the listing is the static file app/api/files.json
serve [GET "api/files.json" [#(demo: true)]]

"the demo project"
[see "demo: Save downloads the file"  see {title "Bike workshop"}  see {booking: panel "Book a repair"}]
[
    click {field name "Your name"}
    type "Text" "Name"
    see "Changed"
    choose "File" "contact.trb"
    see {heading "Write to us"}
    choose "File" "app.trb"
    see {field name "Name"}
    see "Changed"
]

Trebol [
    title: "Fragments in the designer: pieces of machine made once, used in states, and the edits they take"
    exports: [
        engine-block fragment-problem late-use-problem fragment-before-machines machine-head rename-machine delete-machine-text new-fragment-code
        set-use use-with-value set-use-with fragment-spec-value set-fragment-spec uses-of
    ]
]

import %model.trb
import %machines.trb
import %machine-edits.trb

; The file is never run, so the words a machine's use names are not set: to make it as the engine does,
; for its problems or to try it, its block is copied and bound to the fragments written before it, made
; from their text. A fragment written after the machine is not made yet when the file runs.
engine-block: function [
    "A copy of a machine's block, its use words bound to the fragments written before it in the file"
    ms [block!] m [object!]
] [
    frs: fragments-before ms m
    b: copy/deep m/block
    if empty? frs [return b]
    ctx: make object! append collect [foreach f frs [keep to set-word! f/name]] none
    foreach f frs [
        body: copy/deep f/block
        bind body ctx
        set in ctx f/name attempt [fragment copy/deep f/spec body]
    ]
    bind b ctx
]

fragments-before: function ["The fragments written before a machine" ms [block!] m [object!]] [
    collect [foreach x ms [if same? x m [break]  if x/kind = 'fragment [keep x]]]
]

late-use-problem: function [
    "The problem of a machine that uses a fragment written after it: [line:col message], or none"
    d [object!] ms [block!] m [object!]
] [
    before: collect [foreach f fragments-before ms m [keep f/name]]
    foreach n next m/nodes [
        if all [n/uses  not find before n/uses  fragment-named ms n/uses] [
            at: none
            foreach k keys-of d/spots [
                v: select d/spots k
                if all [same? v/2 n/block  v/3 = (n/use-at + 1)] [at: k]
            ]
            return reduce [at rejoin ["state " n/name " uses " n/uses ", a fragment written after the machine: write it before"]]
        ]
    ]
    none
]

fragment-before-machines: function [
    "The text with a fragment's code put before the first machine that is no fragment, or at the end when there is none"
    d [object!] ms [block!] code [string!]
] [
    first-m: none
    foreach m ms [if m/kind <> 'fragment [first-m: m  break]]
    if all [first-m  h: machine-head d first-m] [
        pos: first span-of d h/1 h/2
        ; the statement of the file that holds it, with the words set before it
        top: none
        repeat i length? d/values [if (first span-of d d/values i) <= pos [top: i]]
        if top [
            while [all [top > 1  set-word? pick d/values top - 1]] [top: top - 1]
            at-i: line-start d/text first span-of d d/values top
            return splice d/text at-i 0 rejoin [code newline]
        ]
    ]
    t: copy d/text
    unless any [empty? t  newline = last t] [append t newline]
    unless empty? t [append t newline]
    append t code
]

fragment-problem: function ["What is wrong with a fragment's blanks, or none" f [object!]] [
    e: try [fragment copy/deep f/spec copy/deep f/block]
    either error? e [e] [none]
]

uses-of: function ["The states of the machines that use a fragment: [machine node ...]" ms [block!] name [word!]] [
    collect [foreach m ms [foreach n next m/nodes [if n/uses = name [keep m  keep n]]]]
]

; --- the head of a machine: repair: machine [...] or retry: fragment [...] [...] ---------------------------

machine-head: function [
    "Where a machine is written in the file: [block index], the index of its word (repair:) or of machine itself"
    d [object!] m [object!]
] [
    foreach [blk sps own] d/blocks [
        repeat i length? blk [
            if same? pick blk i m/block [
                h: either m/kind = 'fragment [i - 2] [i - 1]
                if all [h > 1  set-word? pick blk h - 1] [h: h - 1]
                return reduce [blk h]
            ]
        ]
    ]
    none
]

rename-machine: function [
    "The text with a machine or fragment set to another word; the states that use a fragment use it by its new name"
    d [object!] ms [block!] m [object!] v [word!]
] [
    unless at: machine-head d m [return none]
    if all [m/kind = 'fragment  any [find collect [foreach x ms [if x/name [keep x/name]]] v]] [return none]
    blk: at/1  h: at/2
    changes: either set-word? pick blk h [
        value-change d blk h rejoin [v ":"]
    ] [
        s: span-of d blk h
        reduce [s/x 0 rejoin [v ": "]]
    ]
    if all [m/kind = 'fragment  m/name] [
        foreach [x n] uses-of ms m/name [append changes value-change d n/block n/use-at + 1 form v]
    ]
    apply-changes d/text changes
]

delete-machine-text: function ["The text without a machine or fragment" d [object!] m [object!]] [
    unless at: machine-head d m [return none]
    i: at/2 + either set-word? pick at/1 at/2 [1] [0]
    cut d/text range-span d at/1 at/2 i + either m/kind = 'fragment [2] [1]
]

new-fragment-code: function ["The code of a new fragment, named so that no machine or fragment has its name" ms [block!]] [
    names: collect [foreach m ms [if m/name [keep m/name]]]
    name: 'fragment-1
    k: 1
    while [find names name] [k: k + 1  name: to word! rejoin ["fragment-" k]]
    rejoin [name ": fragment [] [" newline "    initial start" newline "    state start []" newline "]" newline]
]

; --- the edits of a state that uses one ----------------------------------------------------------------

set-use: function [
    "The text with a state using a fragment by name, or using none for none"
    d [object!] m [object!] id [integer!] name
] [
    n: machine-node m id
    case [
        all [none? name  n/use-at] [apply-changes d/text cut-change d n/block n/use-at either n/with-at [n/with-at + 1] [n/use-at + 1]]
        none? name [d/text]
        n/use-at [apply-changes d/text value-change d n/block n/use-at + 1 form name]
        true [set-state-word d m id 'use form name]
    ]
]

use-with-value: function ["What a state gives the blanks of the fragment it uses, as written inside with's block, or none" d [object!] m [object!] id [integer!]] [
    n: machine-node m id
    unless all [n/with-at  block? pick n/block n/with-at + 1] [return none]
    s: span-of d n/block n/with-at + 1
    copy/part at d/text s/x + 1 s/y - 2
]

set-use-with: function [
    "The text with what a state gives the blanks of its fragment: work: [charge] check: [data/ok]; none or empty takes with out"
    d [object!] m [object!] id [integer!] code
] [
    n: machine-node m id
    empty: any [none? code  empty? trim copy code]
    case [
        all [empty  n/with-at] [apply-changes d/text cut-change d n/block n/with-at n/with-at + 1]
        empty [d/text]
        n/with-at [apply-changes d/text value-change d n/block n/with-at + 1 rejoin ["[" trim copy code "]"]]
        n/use-at [
            s: span-of d n/block n/use-at + 1
            splice d/text s/x + s/y 0 rejoin [" with [" trim copy code "]"]
        ]
        true [none]
    ]
]

; --- the blanks of a fragment ----------------------------------------------------------------------------

fragment-spec-value: function ["A fragment's blanks as written inside its spec block" d [object!] m [object!]] [
    s: block-span d m/spec
    copy/part at d/text s/x + 1 s/y - 2
]

set-fragment-spec: function ["The text with a fragment's blanks: work [block!] check [block!]" d [object!] m [object!] code [string!]] [
    s: block-span d m/spec
    splice d/text s/x s/y rejoin ["[" trim copy code "]"]
]

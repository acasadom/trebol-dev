Trebol [
    title: "The design of a file: its text, its values and faces, and the edits that change the text"
    exports: [
        design-of spot-of span-of face-range face-span face-code faces-of
        splice cut replace-value remove-face insert-after insert-into move-face
        set-face-text set-face-name face-label style-word toggle-flag
        layout-of head-end block-span indent-at after-line shown-faces
        pane-of own-block written-range values-at inside? set-screen screens-data add-screen piece? set-piece-label add-piece
        set-face-label set-face-global
    ]
]

; The text is the truth. A design is what can be read from it: its values (load/all), where each
; sits (load-spans) and the faces of each layout in it, laid out without running anything
; (ui-sketch). Every edit gives new text that changes only what it must, so comments, spacing and
; order stay as they were written; the designer reads the new text again.

spot-move: function [
    "Moves the cursor of a walk over the text to a character index, counting lines and columns as loaded-at does"
    st [object!] text [string!] to [integer!]
] [
    while [st/i < to] [
        c: pick text st/i
        either c = newline [st/line: st/line + 1  st/col: 1] [
            ; columns count UTF-16 units, as the lexer and editors do
            st/col: st/col + either c > #"^(FFFF)" [2] [1]
        ]
        st/i: st/i + 1
    ]
]

design-of: function [
    "What the designer reads from a file's text: values, where each sits, and the faces of its layouts"
    text [string!]
] [
    values: load/all text
    spans: load-spans text
    ; load drops a script header; its two spans come first
    header: none
    if (length? spans) > length? values [
        header: copy/part spans 2
        spans: skip spans 2
    ]
    d: make object! [
        text: none values: none header: none
        spots: none     ; "line:col" -> [span block index]
        blocks: none    ; [block spans own ...]: each loaded block, its values' spans and its own (none at the top)
        layouts: none   ; block of objects: kind block view problems
        defs: none      ; style -> style-def of the styles the file redefines
        own: none       ; the styles the file defines or redefines, that a layout writes
        screens: none   ; [screens-face its-screens ...]: all of them, whichever the preview shows
    ]
    d/text: text
    d/values: values
    d/header: header
    d/spots: make map! []
    d/blocks: copy []
    st: make object! [i: 1 line: 1 col: 1]
    ; spans in walk order are in text order: a block's own span comes before its values'
    walk: function [vals sps own-span] [
        append d/blocks reduce [vals sps own-span]
        repeat n length? vals [
            sp: pick sps n
            own: either block? sp [first sp] [sp]
            spot-move st text own/x
            put d/spots rejoin [st/line ":" st/col] reduce [own vals n]
            if block? sp [walk pick vals n  next sp  own]
        ]
    ]
    walk values spans none
    d/layouts: copy []
    find-layouts: function [code] [
        parse code [any [
            p: ['view | 'layout | path! if (find [view layout] first first p)]
            opt ['compose | path! if ('compose = first first next p)]
            set b block! (
                r: ui-sketch b
                k: either path? first p [first first p] [first p]
                append d/layouts make object! [kind: k  block: b  view: r/1  problems: r/2]
                find-layouts b
            )
            ; stylize [view: view [...]] defines a style: its blocks are no layouts
            | 'stylize block!
            | set b [block! | paren!] (find-layouts b)
            | skip
        ]]
    ]
    ; the styles and rules the file defines, as check reads them, then its layouts with them
    before: reduce [copy ui-style-defs  copy styles]
    run-own values 'rule
    run-own values 'stylize
    find-layouts values
    ; every screen of a screens face: the preview shows one of them, the structure all
    d/screens: copy []
    keep-screens: function [fs] [foreach f fs [
        if f/style = 'screens [append d/screens reduce [f copy any [f/pane []]]]
        if block? f/pane [keep-screens f/pane]
    ]]
    foreach l d/layouts [if l/view [keep-screens l/view/pane]]
    ; what the file defines anew stays known; a style it redefines is its own, kept in the design,
    ; and the one before comes back, so the designer's own screen never changes (rule cannot
    ; redefine one of Trebol's)
    d/defs: make map! []
    d/own: collect [foreach [k v] styles [unless same? v select before/2 k [keep k]]]
    foreach [m old] reduce [ui-style-defs before/1  styles before/2] [
        foreach k keys-of old [
            unless same? select m k select old k [
                if same? m ui-style-defs [put d/defs k select m k]
                put m k select old k
            ]
        ]
    ]
    d
]

; Runs the rule or stylize blocks of a file's code, and those inside its blocks; one that fails is left out.
run-own: function [code [block! paren!] kind [word!] /local b n m] [
    parse code [any [
        'stylize set b block! (if kind = 'stylize [attempt [stylize copy/deep b]])
        | 'rule set n lit-word! set m [string! | map! | block!] set b block! (if kind = 'rule [attempt [rule to word! n m copy/deep b]])
        | set b [block! | paren!] (run-own b kind)
        | skip
    ]]
]

spot-of: function [
    "Where a value sits, from its place (loaded-at, a face's place or written): [span block index], or none"
    d [object!] place [string! none!]
] [
    unless place [return none]
    ; a place may start with a file name: the line and column are the last two parts
    parts: split place #":"
    n: length? parts
    if n < 2 [return none]
    select d/spots rejoin [pick parts n - 1 ":" last parts]
]

spans-of: function [
    "The spans of the values of a loaded block of the design"
    d [object!] b [block! paren!]
] [
    foreach [blk sps own] d/blocks [if same? head blk head b [return sps]]
    none
]

span-of: function [
    "Where the value at an index of a loaded block sits in the text: index x length"
    d [object!] b [block! paren!] n [integer!]
] [
    sp: pick spans-of d b n
    either block? sp [first sp] [sp]
]

layout-of: function ["The layout whose view a face is, or none" d [object!] f [object!]] [
    foreach l d/layouts [if same? l/view f [return l]]
    none
]

head-end: function [
    "The index of the last value before a layout's first face: its view's own words; 0 when there are none"
    b [block!]
] [
    n: 1
    while [n <= length? b] [
        v: pick b n
        if any [set-word? :v  paren? :v  'global = :v  all [word? :v  select styles v]] [break]
        n: n + 1
    ]
    n - 1
]

written-range: function [
    "Where a face was written: [block first last], indexes in the loaded block; none if made at run time"
    d [object!] f [object!]
] [
    unless f/written [return none]
    a: spot-of d f/written/1
    z: spot-of d f/written/2
    unless all [a z  same? a/2 z/2] [return none]
    reduce [a/2 a/3 z/3]
]

own-block: function [
    "The block whose first words are a face's own: a view's, or a screen's (home ^"Home^" [...]); none for others"
    d [object!] f [object!]
] [
    if l: layout-of d f [return l/block]
    if all [find [screen tab step] f/style  r: written-range d f] [
        b: pick r/1 r/3
        if block? b [return b]
    ]
    none
]

piece?: func ["Whether a face is a piece of the face it is in, written there with its label: a tab or a step" f] [
    to logic! find [tab step] f/style
]

set-piece-label: function ["The text with a tab's or a step's label changed" d [object!] f [object!] new [string!]] [
    r: written-range d f
    i: either word? pick r/1 r/2 [r/2 + 1] [r/2]
    replace-value d r/1 i new
]

add-piece: function [
    "The text with a new, empty tab or step last in its tabs or steps: f is that face or one of its pieces"
    d [object!] f [object!] kind [word!]
] [
    b: none
    either piece? f [b: first written-range d f] [
        r: face-range d f
        foreach v copy/part at r/1 r/2 r/3 - r/2 + 1 [if block? v [b: v]]
    ]
    unless b [return none]
    n: 1 + to integer! (length? b) / 2
    label: rejoin [either kind = 'tab ["Tab "] ["Step "] n]
    ; steps a machine leads name the state of each
    either word? first b [
        insert-into d b rejoin ["state-" n " " mold label " []"]
    ] [insert-into d b rejoin [mold label " []"]]
]

face-range: function [
    "The values a face was written with: [block first last], indexes in the loaded block; none if made at run time"
    d [object!] f [object!]
] [
    ; a view or a screen: the words before its first face; a tab or a step: none
    if b: own-block d f [return reduce [b 1 either piece? f [0] [head-end b]]]
    unless f/written [return none]
    a: spot-of d f/written/1
    z: spot-of d f/written/2
    unless all [a z  same? a/2 z/2] [return none]
    reduce [a/2 a/3 z/3]
]

face-span: function [
    "Where the text of a face sits: index x length"
    d [object!] f [object!]
] [
    if l: layout-of d f [return block-span d l/block]
    if all [find [screen tab step] f/style  r: written-range d f] [return values-at d r/1 r/2 r/3]
    unless r: face-range d f [return none]
    a: span-of d r/1 r/2
    z: span-of d r/1 r/3
    as-pair a/x z/x + z/y - a/x
]

values-at: function ["Where the values from one index to another of a loaded block sit" d [object!] b [block!] from [integer!] to [integer!]] [
    a: span-of d b from
    z: span-of d b to
    as-pair a/x z/x + z/y - a/x
]

block-span: function ["Where a loaded block sits, its brackets too" d [object!] b [block!]] [
    foreach [blk sps own] d/blocks [if same? head blk head b [return own]]
    none
]

face-code: function ["The text a face was written with" d [object!] f [object!]] [
    s: face-span d f
    copy/part at d/text s/x s/y
]

pane-of: function ["The faces a face holds: every screen of a screens face" d [object!] f [object!]] [
    any [select/same d/screens f  all [block? f/pane  f/pane]]
]

faces-of: function [
    "Every face of the design's layouts that was written in the text, in order, nested ones after their parent"
    d [object!]
] [
    out: copy []
    walk: function [fs] [
        foreach f fs [
            if face-range d f [append out f]
            if fs: pane-of d f [walk fs]
        ]
    ]
    foreach l d/layouts [if l/view [walk l/view/pane]]
    out
]

shown-faces: function [
    "The faces the structure shows: each layout's view, then the faces written in it, as faces-of gives them"
    d [object!]
] [
    out: copy []
    fs: faces-of d
    foreach l d/layouts [if l/view [
        append out l/view
        foreach f fs [if inside? d f l/view [append out f]]
    ]]
    out
]

inside?: function [d [object!] f [object!] v [object!]] [
    foreach g any [pane-of d v []] [if any [same? g f  inside? d f g] [return true]]
    false
]

; --- edits: each takes a design and gives the new text --------------------------------------

splice: function [
    "The text with length characters at an index replaced by new text"
    text [string!] at-index [integer!] len [integer!] new [string!]
] [
    t: copy text
    change/part at t at-index new len
    t
]

line-start: function ["The index where the line holding an index starts" text [string!] n [integer!]] [
    while [all [n > 1  newline <> pick text n - 1]] [n: n - 1]
    n
]

indent-at: function ["The spaces and tabs that start the line holding an index" text [string!] n [integer!]] [
    s: line-start text n
    e: s
    while [all [e <= length? text  find " ^-" pick text e]] [e: e + 1]
    copy/part at text s e - s
]

blank?: function ["Whether text holds only spaces and tabs" s [string!]] [
    parse s [any [#" " | #"^-"]]
]

after-line: function [
    "Where to put a new line after a value that ends at an index: the end of its line when only spaces or a comment follow it"
    text [string!] n [integer!]
] [
    rest: find at text n newline
    tail-text: copy/part at text n either rest [(index? rest) - n] [length? at text n]
    either any [blank? tail-text  #";" = first trim/head copy tail-text] [n + length? tail-text] [n]
]

more-on-line?: function ["Whether more than spaces or a comment follows an index on its line" text [string!] n [integer!]] [
    rest: find at text n newline
    tail-text: copy/part at text n either rest [(index? rest) - n] [length? at text n]
    not any [blank? tail-text  #";" = first trim/head copy tail-text]
]

replace-value: function [
    "The text with the value at an index of a loaded block written anew"
    d [object!] b [block! paren!] n [integer!] new [any-type!]
] [
    s: span-of d b n
    splice d/text s/x s/y mold :new
]

cut: function [
    "The text without the characters of a span, and its line too when nothing else is on it"
    text [string!] s [pair!]
] [
    from: s/x
    stop: s/x + s/y
    before: copy/part at text line-start text from from - line-start text from
    rest: find/tail at text stop newline
    after: copy/part at text stop either rest [(index? rest) - 1 - stop] [length? at text stop]
    ; trailing comments go with the value when it is alone on its line
    if all [blank? before  any [blank? after  #";" = first trim/head copy after]] [
        from: line-start text from
        stop: either rest [index? rest] [1 + length? text]
        ; the last line of the text has no newline after it: take the one before
        if all [not rest  from > 1] [from: from - 1]
        return splice text from stop - from ""
    ]
    ; otherwise the spaces before it go too, or after it when it opens its block: [a b] -> [b]
    either all [from > 1  find " ^-" pick text from - 1] [
        while [all [from > 1  find " ^-" pick text from - 1]] [from: from - 1]
    ] [
        while [all [stop <= length? text  find " ^-" pick text stop]] [stop: stop + 1]
    ]
    splice text from stop - from ""
]

remove-face: function ["The text without a face" d [object!] f [object!]] [
    cut d/text face-span d f
]

; code of several lines, each line after the first indented as the place it goes
indented: function [code [string!] indent [string!]] [
    replace/all copy code newline rejoin [newline indent]
]

insert-after: function [
    "The text with new code on its own line after a face, indented as it is"
    d [object!] f [object!] code [string!]
] [
    s: face-span d f
    indent: indent-at d/text s/x
    n: after-line d/text s/x + s/y
    ; more is written after it on its line, as in row [a  b]: beside it, as the line is written
    if all [more-on-line? d/text s/x + s/y  not find code newline] [return splice d/text n 0 rejoin ["  " code]]
    splice d/text n 0 rejoin [newline indent indented code indent]
]

insert-into: function [
    "The text with new code as the last value of a loaded block (a layout or a panel's block)"
    d [object!] b [block!] code [string!]
] [
    owner: none
    foreach [blk sps own] d/blocks [if same? head blk head b [owner: own]]
    unless owner [return none]
    close: owner/x + owner/y - 1   ; the ]
    if empty? b [
        ; [] becomes a block of lines: [, the code a step in, ] under the line it opens on
        outer: indent-at d/text owner/x
        inner: rejoin [outer "    "]
        return splice d/text owner/x + 1 close - owner/x - 1 rejoin [newline inner indented code inner newline outer]
    ]
    last-span: span-of d b length? b
    indent: indent-at d/text last-span/x
    n: after-line d/text last-span/x + last-span/y
    ; a block on one line, [field "a"]: the new code goes beside the last value; code of more lines than
    ; one opens the block onto lines, its ] under the line it opens on
    if more-on-line? d/text last-span/x + last-span/y [
        unless find code newline [return splice d/text n 0 rejoin ["  " code]]
        outer: indent-at d/text owner/x
        inner: rejoin [outer "    "]
        return splice d/text n 0 rejoin [newline inner indented code inner newline outer]
    ]
    splice d/text n 0 rejoin [newline indent indented code indent]
]

move-face: function [
    "The text with a face moved after another face, or before it"
    d [object!] f [object!] target [object!]
    /before "Before the other face"
] [
    s: face-span d f
    ; a comment after the face on its line goes with it
    code: copy/part at d/text s/x (after-line d/text s/x + s/y) - s/x
    t: face-span d target
    if s = t [return d/text]
    indent: indent-at d/text t/x
    either before [
        at-index: t/x
        piece: rejoin [code newline indent]
    ] [
        at-index: after-line d/text t/x + t/y
        piece: rejoin [newline indent code]
    ]
    ; the later place first, so the earlier one stays where it was
    either at-index > s/x [
        cut splice d/text at-index 0 piece s
    ] [
        splice cut d/text s at-index 0 piece
    ]
]

text-index: function [
    "The index in its block of the string a face shows, or none; the first string after its style and name"
    d [object!] f [object!]
] [
    r: face-range d f
    b: r/1
    n: r/2
    while [n <= r/3] [
        v: pick b n
        if string? :v [return n]
        ; the action block or anything after it is not the face's text
        if block? :v [return none]
        n: n + 1
    ]
    none
]

style-index: function [
    "The index in its block of the word a face was written with: after global and its label"
    d [object!] f [object!]
] [
    r: face-range d f
    n: r/2
    if 'global = pick r/1 n [n: n + 1]
    if set-word? pick r/1 n [n: n + 1]
    n
]

style-word: function ["The word a face was written with: submit for a submit button" d [object!] f [object!]] [
    if layout-of d f [return 'view]
    if own-block d f [return f/style]
    r: face-range d f
    pick r/1 style-index d f
]

set-face-text: function [
    "The text with the string a face shows changed, or added after its style and name"
    d [object!] f [object!] new [string!]
] [
    if n: text-index d f [return replace-value d first face-range d f n new]
    r: face-range d f
    n: style-index d f
    if all [f/name  n < r/3  f/name = pick r/1 n + 1] [n: n + 1]
    s: span-of d r/1 n
    splice d/text s/x + s/y 0 rejoin [" " mold new]
]

toggle-flag: function [
    "The text with a flag word of a face taken out if it has it, or put after its text"
    d [object!] f [object!] flag [word!]
] [
    r: face-range d f
    n: r/2
    while [n <= r/3] [
        if all [word? pick r/1 n  flag = pick r/1 n  n > style-index d f] [return cut d/text span-of d r/1 n]
        n: n + 1
    ]
    n: any [text-index d f  style-index d f]
    s: span-of d r/1 n
    splice d/text s/x + s/y 0 rejoin [" " flag]
]

face-label: function ["The word a face is set to, sign-up: panel, or none" d [object!] f [object!]] [
    if own-block d f [return none]
    r: face-range d f
    v: pick r/1 r/2
    if all [word? :v  'global = v] [v: pick r/1 r/2 + 1]
    either set-word? :v [to word! v] [none]
]

set-face-label: function [
    "The text with the word a face is set to (who: field) changed, added before its style, or, none, taken out with global"
    d [object!] f [object!] new [word! none!]
] [
    r: face-range d f
    n: style-index d f
    had: either set-word? pick r/1 n - 1 [n - 1] [none]
    case [
        all [had new] [replace-value d r/1 had to set-word! new]
        had [
            a: span-of d r/1 r/2  z: span-of d r/1 had
            s: as-pair a/x z/x + z/y - a/x
            ; and the space after it
            if #" " = pick d/text s/x + s/y [s/y: s/y + 1]
            splice d/text s/x s/y ""
        ]
        new [s: span-of d r/1 n  splice d/text s/x 0 rejoin [new ": "]]
        true [d/text]
    ]
]

set-face-global: function [
    "The text with a face's word set globally (global who: field), or locally"
    d [object!] f [object!] on [logic!]
] [
    r: face-range d f
    was: 'global = pick r/1 r/2
    case [
        all [on  not was] [s: span-of d r/1 r/2  splice d/text s/x 0 "global "]
        all [was  not on] [
            s: span-of d r/1 r/2
            if #" " = pick d/text s/x + s/y [s/y: s/y + 1]
            splice d/text s/x s/y ""
        ]
        true [d/text]
    ]
]

set-screen: function [
    "The text with a screen's name, title or arguments (none takes them out) changed: home ^"Home^" [id] [...]"
    d [object!] f [object!] what [word!] new
] [
    r: written-range d f
    b: r/1  i: r/2
    args?: r/3 = (i + 3)
    switch what [
        name [replace-value d b i new]
        title [replace-value d b i + 1 new]
        args [
            case [
                all [args?  any [none? new  empty? new]] [
                    s: span-of d b i + 2
                    if #" " = pick d/text s/x + s/y [s/y: s/y + 1]
                    splice d/text s/x s/y ""
                ]
                args? [replace-value d b i + 2 new]
                all [new  not empty? new] [s: span-of d b r/3  splice d/text s/x 0 rejoin [mold new " "]]
                true [d/text]
            ]
        ]
    ]
]

screens-data: function ["The block of a screens face's screens, or of the screens a screen is among" d [object!] f [object!]] [
    if f/style = 'screen [return first written-range d f]
    r: face-range d f
    foreach v copy/part at r/1 r/2 r/3 - r/2 + 1 [if block? v [return v]]
    none
]

add-screen: function ["The text with a new, empty screen last among those of a screens face or screen" d [object!] f [object!]] [
    unless b: screens-data d f [return none]
    n: 1
    while [find b to word! rejoin ["screen-" n]] [n: n + 1]
    insert-into d b rejoin ["screen-" n " " mold rejoin ["Screen " n] " []"]
]

set-face-name: function [
    "The text with the name of a face's value changed, or added after its style; none takes it out"
    d [object!] f [object!] new [word! none!]
] [
    r: face-range d f
    n: style-index d f
    if all [f/name  n < r/3  f/name = pick r/1 n + 1] [
        return either new [replace-value d r/1 n + 1 new] [cut d/text span-of d r/1 n + 1]
    ]
    unless new [return d/text]
    s: span-of d r/1 n
    splice d/text s/x + s/y 0 rejoin [" " new]
]

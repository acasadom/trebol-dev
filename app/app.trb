Trebol [
    title: "Trebol designer"
    description: "Lays out the screens of a Trebol project and writes the code back, as you wrote it."
]

; The designer of a project's screens. The file's text is the truth: every change, made on the
; structure, the properties or the code itself, gives new text, and the design is read from it
; again. Saving writes the text back through the file API of server/files.js.

import %model.trb
import %demo.trb
import %palette.trb
import %trebol-code.js

; the styles whose faces are fields of a form: they have a name and can be required
inputs: [field password number money date date-range time area rich check toggle choice radio upload photo lookup rows widget slider]
; the styles whose block holds faces: what is added with one of them chosen goes inside it
boxes: [view row column panel form grid scroll dialog]

files: copy []
path: none          ; the file being designed, from the project's folder
text: ""            ; its text now
saved: ""           ; its text as last read or saved
d: none             ; the design read from text
chosen: none        ; the index of the chosen face in faces-of d
problem: none       ; why the text does not load, when it does not
demo: none          ; with no server: the files of the demo project, kept in the page
demo-saved: none    ; and each as last downloaded

; the file API answers only the designer's own pages, which say so with this header
api-get: func [url] [fetch/with url [headers: [X-Trebol-Dev "1"]]]
api-put: func [url content] [fetch/with url [method: 'PUT  body: content  headers: [X-Trebol-Dev "1"]]]

read-files: function [] [
    ; no file API answers on a web page: the demo project, saved by downloading
    either error? r: try [api-get "/api/files"] [
        set 'demo copy demo-files
        set 'demo-saved copy demo-files
        project-name/text: "demo: Save downloads the file"
        set 'files sort keys-of demo
    ] [
        project-name/text: r/name
        set 'files r/files
    ]
    file-choice/options: files
    either empty? files [nothing/hidden: false] [open-file first files]
]

open-file: function [name [string!]] [
    if all [path  text <> saved] [
        ; the demo keeps the changes of a file left; a project's file is left only if the user says so
        either demo [put demo path text] [
            unless confirm/role rejoin [path " has changes that are not saved. Leave them?"] 'danger [
                file-choice/value: path
                exit
            ]
        ]
    ]
    set 'path name
    file-choice/value: name
    t: either demo [select demo name] [api-get rejoin ["/api/file?path=" enhex name]]
    set 'saved either demo [select demo-saved name] [t]
    set 'chosen none
    change-text t
]

save-file: function [] [
    either demo [
        put demo path text
        put demo-saved path text
        download last split path #"/" text
    ] [
        api-put rejoin ["/api/file?path=" enhex path] text
    ]
    set 'saved text
    toast "Saved"
    redraw
]

; New text, from any change: read it again; text that does not load keeps the last design.
change-text: function [t [string!]] [
    set 'text t
    either error? e: try [design-of t] [
        set 'problem form e/message
    ] [
        set 'problem none
        set 'd e
    ]
    redraw
]

edit: function [t [string! none!]] [if t [change-text t]]

the-face: does [all [d chosen  pick faces-of d chosen]]

face-name: function [f] [
    s: form style-word d f
    if l: face-label d f [s: rejoin [l ": " s]]
    ; a grid says how it splits: grid 3, grid [1 2 1]
    if all [f/style = 'grid  f/cols] [s: rejoin [s " " mold f/cols]]
    if f/name [s: rejoin [s " " f/name]]
    if string? f/text [
        t: f/text
        ; long texts are cut, so the structure stays narrow
        if 20 < length? t [t: rejoin [copy/part t 19 "…"]]
        s: rejoin [s " " mold t]
    ]
    s
]

; the structure: every face written in the file, nested as written
nodes-of: function [fs [block!] all-faces [block!]] [
    collect [
        foreach f fs [
            either n: find/same all-faces f [
                node: make map! reduce ['id index? n 'name face-name f]
                if block? f/pane [
                    node/children: nodes-of f/pane all-faces
                    node/expanded: true
                ]
                keep node
            ] [
                if block? f/pane [keep nodes-of f/pane all-faces]
            ]
        ]
    ]
]

node-of: function [id list [block!]] [
    unless id [return none]
    foreach n list [
        if n/id = id [return n]
        if n/children [if found: node-of id n/children [return found]]
    ]
    none
]

redraw: function [] [
    file-state/text: case [
        problem ["Not saved: the code does not load"]
        text = saved ["Saved"]
        true ["Changed"]
    ]
    save-button/disabled: any [problem  text = saved  not path]
    code-view/value: text
    problem-text/hidden: not problem
    problem-text/text: any [problem ""]
    unless d [exit]
    fs: faces-of d
    structure/data: collect [foreach l d/layouts [if l/view [keep nodes-of l/view/pane fs]]]
    if all [chosen  chosen > length? fs] [set 'chosen none]
    structure/selected: node-of chosen structure/data
    preview/pane: collect [foreach l d/layouts [if l/view [keep l/view/pane]]]
    mark-chosen
    problems/data: collect [
        foreach l d/layouts [foreach [p m] l/problems [keep make map! reduce ['at any [loaded-at p ""] 'message m]]]
    ]
    problems/hidden: empty? problems/data
    problem-count/text: either empty? problems/data ["No problems"] [
        rejoin [length? problems/data either 1 = length? problems/data [" problem"] [" problems"]]
    ]
    show-props
]

show-props: function [] [
    f: the-face
    props/hidden: not f
    nothing-chosen/hidden: to logic! f
    unless f [exit]
    face-kind/text: face-name f
    text-f/value: either string? f/text [f/text] [""]
    ; faces that hold others and show no text of their own have none to change
    text-f/hidden: all [not string? f/text  find [view row column form grid split tabs steps toolbar desktop divider] f/style]
    name-f/hidden: not find inputs f/style
    name-f/value: either f/name [form f/name] [""]
    required-f/hidden: not find inputs f/style
    required-f/value: has-rule? f 'required
    i: cols-at f
    cols-f/hidden: not i
    if i [cols-f/value: mold/only pick first face-range d f i]
]

; where the columns of a grid are written: grid 3 [...], grid [1 2 1] [...]; an index in its loaded block
cols-at: function [f] [
    unless all [f/style = 'grid  r: face-range d f] [return none]
    i: r/2
    while [i < r/3] [
        v: pick r/1 i
        if all [word? v  v = 'grid] [break]
        i: i + 1
    ]
    i: i + 1
    if all [i < r/3  any [integer? pick r/1 i  block? pick r/1 i]] [return i]
    none
]

; what is typed as the columns: 3, or a weight per column (1 2 1), small, medium or large for a fixed width
cols-of: function [value] [
    v: attempt [load value]
    case [
        all [integer? v  v > 0  v <= 12] [v]
        all [block? v  not empty? v  parse v [some [integer! | 'small | 'medium | 'large]]] [v]
        true [none]
    ]
]

set-cols: function [value] [
    f: the-face
    unless all [f  i: cols-at f  v: cols-of value] [exit]
    edit replace-value d first face-range d f i v
]

; the loaded block that holds a box's faces
pane-block: function [f] [
    unless all [find boxes f/style  r: face-range d f] [return none]
    b: pick r/1 r/3
    either block? b [b] [none]
]

; a field's name is a word: letters, digits and - after a letter
name-ok?: function [value] [
    if any [none? value  empty? value] [return true]
    either parse value [letter any [letter | digit | #"-"]] [true] ["A name starts with a letter and holds letters, digits and -"]
]
letter: charset [#"a" - #"z" #"A" - #"Z"]
digit: charset "0123456789"

has-rule?: function [f name [word!]] [
    if f/rules [foreach r f/rules [if all [block? r  name = first r] [return true]]]
    false
]

choose-face: function [id] [
    set 'chosen id
    structure/selected: node-of chosen structure/data
    mark-chosen
    show-props
]

; the chosen face, marked in the preview and in the code
mark-chosen: function [] [
    f: the-face
    preview/selected: f
    s: all [f  face-span d f]
    code-view/props: make code-view/props [mark: either s [reduce [s/x s/y]] [none]]
]

; a face clicked in the preview
pick-face: function [f [object!]] [
    if n: find/same faces-of d f [choose-face index? n]
]

; the cursor put in the code: the innermost face written around it
caret-at: function [at [integer!]] [
    unless d [exit]
    best: none
    n: 0
    foreach f faces-of d [
        n: n + 1
        if all [s: face-span d f  at >= s/x  at <= (s/x + s/y)] [
            if any [not best  s/y <= best/2] [best: reduce [n s/y]]
        ]
    ]
    if all [best  best/1 <> chosen] [choose-face best/1]
]

; Design, Split or Code: what the middle shows
show-mode: function [m] [
    preview-pane/hidden: m = "Code"
    code-pane/hidden: m = "Design"
    centre/cols: either m = "Split" [[1 1]] [[1]]
]

; the code view colours the dialect's words: styles, and the words that change them
code-words: make map! []
foreach w ui-dialect-words [put code-words w either select styles w ['style] ['flag]]

; up: the sibling before goes after it; down: it goes after the sibling after it
step-face: function [by [integer!]] [
    f: the-face
    unless f [exit]
    r: face-range d f
    before: after: none
    foreach g faces-of d [
        q: face-range d g
        if all [same? head q/1 head r/1  not same? g f] [
            if q/3 < r/2 [before: g]
            if all [q/2 > r/3  not after] [after: g]
        ]
    ]
    either by > 0 [
        if after [edit move-face d f after  set 'chosen chosen + 1 + count-inside after  redraw]
    ] [
        if before [edit move-face/before d f before  set 'chosen chosen - 1 - count-inside before  redraw]
    ]
]

; a row dragged in the structure: its face goes where it was dropped among its siblings
reorder: function [parent from [integer!] to [integer!]] [
    list: either parent [parent/children] [structure/data]
    fs: faces-of d
    ; the tree has moved the row already: it is at to, and the one it went beside next to it
    a: pick list to
    b: pick list either to > from [to - 1] [to + 1]
    f: pick fs a/id
    g: pick fs b/id
    either to > from [
        edit move-face d f g
        set 'chosen b/id + (count-inside g) - count-inside f
    ] [
        edit move-face/before d f g
        set 'chosen b/id
    ]
    redraw
]

; how many faces of the structure a face holds: the chosen index jumps them
count-inside: function [f] [
    n: 0
    if block? f/pane [foreach g f/pane [if g/written [n: n + 1 + count-inside g]]]
    n
]

; an item of the Add menu: inside the chosen face if it holds faces, else after it
add-face: function [item [word!]] [
    unless code: palette-code item [exit]
    f: the-face
    case [
        all [f  b: pane-block f] [edit insert-into d b code]
        f [edit insert-after d f code]
        not empty? d/layouts [edit insert-into d d/layouts/1/block code]
    ]
]

; the Add menu comes from the palette
view compose/deep/only [
    width fill
    row spread middle [
        row middle [
            title "Trebol designer"
            global project-name: text muted ""
            global file-choice: choice "File" [] on-change [if value [open-file value]]
        ]
        global mode-f: radio mode "View" ["Design" "Split" "Code"] segmented on-change [show-mode value]
        row middle [
            global file-state: text muted ""
            global save-button: button #check "Save" primary [save-file]
        ]
    ]
    global nothing: text muted hidden "This project has no .trb files yet."
    grid fit [small 1 medium] [
        panel "Structure" pad 2 [
            global add-button: button #plus "Add" small menu (palette-menu) on-menu [add-face event/picked]
            global structure: tree [name] reorder on-select [choose-face row/id]
                on-reorder [reorder event/parent event/from event/to]
        ]
        global centre: grid fit [1 1] [
            global preview-pane: panel "Preview" [
                global preview: column inert on-select [pick-face event/face] []
                global problems: table [at "Where" message "Problem"] hidden
            ]
            global code-pane: panel "Code" pad 2 [
                global problem-text: text danger hidden ""
                global code-view: widget <trebol-code> fit [words: code-words mark: none] on-change [change-text value]
                    on-caret [caret-at event/detail]
            ]
        ]
        panel "Properties" pad 4 [
            global nothing-chosen: text muted "Choose a face in the structure, the preview or the code."
            global props: column hidden [
                global face-kind: code ""
                global text-f: field "Text" [edit set-face-text d the-face value]
                global name-f: field "Field name" check [name-ok? value] [
                    if true = name-ok? value [edit set-face-name d the-face either empty? value [none] [to word! value]]
                ]
                global required-f: check "Required" on-change [edit toggle-flag d the-face 'required]
                global cols-f: field "Columns" hidden
                    check [either cols-of value [true] ["A number of columns (3), or a weight for each (1 2 1); small, medium or large is a fixed width"]]
                    [set-cols value]
                row [
                    button #arrow-up "Up" [step-face -1]
                    button #arrow-down "Down" [step-face 1]
                    button #trash "Delete" danger [edit remove-face d the-face  set 'chosen none  redraw]
                ]
            ]
        ]
    ]
    global problem-count: text muted small "No problems"
]

mode-f/value: "Split"
read-files

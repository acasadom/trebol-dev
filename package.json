{
  "name": "trebol-dev",
  "version": "0.1.1",
  "description": "The visual designer for Trebol: lays out screens with Trebol's faces and writes the Trebol code back, keeping yours as you wrote it.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://trebol-lang.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acasadom/trebol-dev.git"
  },
  "bugs": {
    "url": "https://github.com/acasadom/trebol-dev/issues"
  },
  "keywords": [
    "trebol",
    "designer",
    "devtools"
  ],
  "bin": {
    "trebol-dev": "bin/trebol-dev.js"
  },
  "files": [
    "bin",
    "server",
    "app",
    "!app/*.test.trb",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test && trebol test app",
    "start": "node bin/trebol-dev.js",
    "build:editor": "esbuild editor/trebol-code.js --bundle --minify --format=esm --target=es2022 --legal-comments=eof --outfile=app/trebol-code.js"
  },
  "dependencies": {
    "trebol": "^0.3.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "esbuild": "^0.28.2"
  }
}
